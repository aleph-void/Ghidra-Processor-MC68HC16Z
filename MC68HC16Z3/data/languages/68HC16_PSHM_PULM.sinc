# --- PULM: mask bit 0 = CCR ... bit 6 = D; pulled in bit order (CCR first) ---
pulmList: "" is regmask=0x00 {  }
pulmList: "CCR" is regmask=0x01 { local cw:2; pull16(cw); CCR = (cw & 0xFFF0) | (CCR & 0x000F); }
pulmList: "K" is regmask=0x02 { local kw:2; pull16(kw); EK = kw(1) >> 4; XK = kw(1) & 0x0F; YK = kw:1 >> 4; ZK = kw:1 & 0x0F; }
pulmList: "CCR,K" is regmask=0x03 { local cw:2; pull16(cw); CCR = (cw & 0xFFF0) | (CCR & 0x000F); local kw:2; pull16(kw); EK = kw(1) >> 4; XK = kw(1) & 0x0F; YK = kw:1 >> 4; ZK = kw:1 & 0x0F; }
pulmList: "IZ" is regmask=0x04 { pull16(IZ); }
pulmList: "CCR,IZ" is regmask=0x05 { local cw:2; pull16(cw); CCR = (cw & 0xFFF0) | (CCR & 0x000F); pull16(IZ); }
pulmList: "K,IZ" is regmask=0x06 { local kw:2; pull16(kw); EK = kw(1) >> 4; XK = kw(1) & 0x0F; YK = kw:1 >> 4; ZK = kw:1 & 0x0F; pull16(IZ); }
